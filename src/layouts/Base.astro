---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../lib/config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const siteOrigin = Astro.site ?? new URL('https://hub.alice001.top');
const ogImage = new URL('/og-image.png', siteOrigin).href;
// build.format='directory'：最终服务 URL 带尾斜杠（与 sitemap / RSS 一致），canonical 对齐之
const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' || pathname.endsWith('/') ? pathname : `${pathname}/`;
const canonical = new URL(canonicalPath, siteOrigin).href;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Twitter 分享卡片 -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL('/rss.xml', siteOrigin).href} />
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <!-- 顶栏（页面切换时保持持久，不参与过渡重绘） -->
    <header transition:persist="site-header" class="sticky top-0 z-50 backdrop-blur-md" style="background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--line);">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3.5">
        <a href="/" class="text-[15px] font-bold tracking-tight" style="transition: opacity var(--dur-fast);">
          arcane<span style="color: var(--accent);">.</span>orion
        </a>
        <nav class="flex items-center gap-5 text-[13.5px]" style="color: var(--ink-muted);">
          <a href="/posts" class="hover:text-[var(--ink)] transition-colors">文章</a>
          <a href={SITE.github} target="_blank" rel="noopener" class="hover:text-[var(--ink)] transition-colors">GitHub</a>
          <span title="私域入口 · 建设中" class="cursor-help select-none opacity-40">⚿</span>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 pb-24">
      <slot />
    </main>

    <footer class="border-t" style="border-color: var(--line);">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-5 py-6 text-xs" style="color: var(--ink-muted);">
        <span>© {new Date().getFullYear()} arcane orion</span>
        <span class="font-mono text-[11px] tracking-widest">{SITE.domain}</span>
      </div>
    </footer>
  </body>
</html>
