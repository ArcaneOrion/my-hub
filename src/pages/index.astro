---
import Base from '../layouts/Base.astro';
import ProfileBlock from '../components/ProfileBlock.astro';
import EntryCard from '../components/EntryCard.astro';
import PostCard from '../components/PostCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getEntries } from '../lib/api/entries';
import { getFeaturedPosts, getPostMetas } from '../lib/api/posts';
import { getProfile } from '../lib/api/profile';

const [entries, featured, profile, allPosts] = await Promise.all([
  getEntries(),
  getFeaturedPosts(4),
  getProfile(),
  getPostMetas(),
]);

// 分栏：section 缺失时按 kind 兜底（兼容迁移前的旧数据）
const sectionOf = (e: (typeof entries)[number]) =>
  e.section ?? (e.kind === 'internal' ? 'blog' : 'works');

const blogEntry = entries.find((e) => sectionOf(e) === 'blog');
const works = entries.filter((e) => sectionOf(e) === 'works');
const services = entries.filter((e) => sectionOf(e) === 'services');
---

<Base>
  <div class="relative pt-10 md:pt-14">
    <!-- 背景光斑：滚动视差分层（reduced-motion 时脚本自动关停） -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div data-parallax="-0.05" class="absolute left-[6%] top-24 h-56 w-56 rounded-full opacity-[0.13]" style="background: radial-gradient(closest-side, var(--accent), transparent); filter: blur(42px);"></div>
      <div data-parallax="-0.10" class="absolute right-[4%] top-[430px] h-72 w-72 rounded-full opacity-[0.09]" style="background: radial-gradient(closest-side, var(--accent), transparent); filter: blur(52px);"></div>
    </div>

    <ProfileBlock profile={profile} />

    <!-- 博客：独放一栏 -->
    {blogEntry && (
      <section class="mt-12">
        <a href={`/${blogEntry.id}`} class="card rise group flex items-center gap-5 p-6 md:p-7" style="--i:1">
          <span class="text-[32px] leading-none" aria-hidden="true">{blogEntry.icon}</span>
          <div class="flex-1">
            <h2 class="text-lg font-bold tracking-tight md:text-xl">
              {blogEntry.title}
              <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 group-hover:text-[var(--accent)]">→</span>
            </h2>
            <p class="mt-1 text-[13.5px]" style="color: var(--ink-muted);">
              {blogEntry.tagline} · 共 {allPosts.length} 篇
            </p>
          </div>
          <span class="metalabel hidden sm:block">writing</span>
        </a>
      </section>
    )}

    <!-- 作品 -->
    <section class="mt-14">
      <SectionHeader title="作品" />
      <div class="grid auto-rows-[160px] grid-flow-dense grid-cols-2 gap-4 md:grid-cols-4">
        {works.map((entry, i) => (
          <div
            class:list={[
              entry.size_hint === 'lg' && 'col-span-2 row-span-2',
              entry.size_hint === 'sm' && 'md:col-span-1',
              entry.size_hint === 'md' && 'col-span-1',
            ]}
          >
            <EntryCard entry={entry} index={i + 2} />
          </div>
        ))}
      </div>
    </section>

    <!-- 服务 -->
    {services.length > 0 && (
      <section class="mt-14">
        <SectionHeader title="服务" />
        <div class="grid auto-rows-[160px] gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((entry, i) => (
            <EntryCard entry={{ ...entry, size_hint: 'md' }} index={i + 2} />
          ))}
        </div>
      </section>
    )}

    <!-- 精选文章 -->
    <section class="mt-14">
      <SectionHeader title="精选文章" href="/posts" />
      <div class="grid gap-4 sm:grid-cols-2">
        {featured.map((post, i) => <PostCard post={post} index={i + 2} />)}
      </div>
    </section>
  </div>
</Base>

<script>
  // 滚动视差：data-parallax 系数 × 滚动距离，rAF 节流，仅 transform（合成层，不掉帧）。
  // reduced-motion 用户直接关停；每次 update 时重新查询节点，兼容 View Transitions 换页。
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const w = window as unknown as { __parallaxBound?: boolean };
    if (!w.__parallaxBound) {
      w.__parallaxBound = true;
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = window.scrollY;
        document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
          el.style.transform = `translate3d(0, ${(y * parseFloat(el.dataset.parallax ?? '0')).toFixed(1)}px, 0)`;
        });
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();
    }
  }
</script>
