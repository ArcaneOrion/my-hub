---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MarkdownIt from 'markdown-it';
import { getServiceEntry, getEntries } from '../../lib/api/entries';

const { id } = Astro.params;
const entry = await getServiceEntry(id!);
if (!entry) return Astro.redirect('/');

const md = new MarkdownIt({ html: false, linkify: true });
const description = md.render(entry.landing_description_md ?? '');
export async function getStaticPaths() {
  const entries = await getEntries();
  return entries
    .filter((e) => e.kind === 'service' && !!e.landing_description_md)
    .map((e) => ({ params: { id: e.id } }));
}
---

<Base title={entry.title} description={entry.tagline ?? undefined}>
  <article class="rise mx-auto max-w-2xl pt-10 md:pt-16" style="--i:0">
    <a href="/" class="text-[13px] transition-colors hover:text-[var(--accent)]" style="color: var(--ink-muted);">← 返回主站</a>

    <header class="card mt-6 p-8">
      <div class="flex items-center justify-between">
        <span class="text-[34px] leading-none" aria-hidden="true">{entry.icon}</span>
        {entry.status && <StatusBadge status={entry.status} />}
      </div>
      <h1 class="mt-4 text-2xl font-bold tracking-tight">{entry.title}</h1>
      <p class="mt-1.5 text-[14px]" style="color: var(--ink-muted);">{entry.tagline}</p>
    </header>

    <div class="mt-6 text-[15.5px] leading-[1.85]">
      <div class="prose-s" set:html={description} />
    </div>

    <div class="mt-8 flex gap-3">
      {entry.external_url ? (
        <a
          href={entry.external_url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition-transform active:scale-95"
          style="background: var(--accent); color: #fff; box-shadow: var(--shadow-rest);"
        >
          访问 ↗ <span class="font-mono text-xs opacity-80">{new URL(entry.external_url).host}</span>
        </a>
      ) : (
        <span class="inline-flex items-center rounded-xl px-5 py-2.5 text-sm" style="background: var(--line); color: var(--ink-muted);">
          {entry.status === 'building' ? '构建中 · 尚未上线' : '自用工具 · 未公开访问'}
        </span>
      )}
    </div>
  </article>
</Base>

<style>
  .prose-s :global(p) { margin: 0.9em 0; }
  .prose-s :global(li) { margin: 0.35em 0; }
  .prose-s :global(ul) { margin: 0.9em 0; padding-left: 1.4em; list-style: disc; }
</style>
