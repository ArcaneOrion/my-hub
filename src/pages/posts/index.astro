---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getPostMetas } from '../../lib/api/posts';

const posts = await getPostMetas();
---

<Base title="文章">
  <div class="rise pt-10 md:pt-14" style="--i:0">
    <h1 class="text-2xl font-bold tracking-tight">文章</h1>
    <p class="mt-2 text-[14px]" style="color: var(--ink-muted);">
      共 {posts.length} 篇 · 写作与思考的完整存档
    </p>
  </div>

  <section class="mt-8">
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} index={i + 1} />)}
    </div>
  </section>
</Base>
