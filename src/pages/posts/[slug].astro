---
import Base from '../../layouts/Base.astro';
import MarkdownIt from 'markdown-it';
import katexPluginMod from '@vscode/markdown-it-katex';
import 'katex/dist/katex.min.css';
import { getPostBySlug, getAllSlugs, getPostMetas } from '../../lib/api/posts';

// 该插件发布物为 CJS 双层包装（{ default: fn }），按实际形态解包
const katexPlugin = (katexPluginMod as { default?: unknown }).default ?? katexPluginMod;

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
if (!post) return Astro.redirect('/posts');

// 上一篇 / 下一篇（getPostMetas 按 published_at 倒序：idx-1 更新，idx+1 更旧）
const metas = await getPostMetas();
const idx = metas.findIndex((m) => m.slug === post.slug);
const newer = idx > 0 ? metas[idx - 1] : undefined;
const older = idx >= 0 && idx < metas.length - 1 ? metas[idx + 1] : undefined;

const md = new MarkdownIt({ html: false, linkify: true }).use(katexPlugin as Parameters<MarkdownIt['use']>[0]);
const content = md.render(post.content_md);
const date = new Date(post.published_at).toLocaleDateString('zh-CN');
export async function getStaticPaths() {
  return (await getAllSlugs()).map((s) => ({ params: { slug: s } }));
}
---

<Base title={post.title} description={post.summary}>
  <article class="rise pt-10 md:pt-16" style="--i:0; max-width: 68ch; margin-inline: auto;">
    <a href="/posts" class="text-[13px] transition-colors hover:text-[var(--accent)]" style="color: var(--ink-muted);">← 全部文章</a>

    <header class="mt-6">
      <div class="flex items-center gap-2 text-xs" style="color: var(--ink-muted);">
        <time datetime={post.published_at}>{date}</time>
        <span>·</span>
        <span class="font-mono uppercase tracking-widest">{post.tags.join(' / ')}</span>
      </div>
      <h1 class="mt-3 text-[26px] font-bold leading-snug tracking-tight md:text-3xl" transition:name={post.slug}>{post.title}</h1>
      <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink-muted);">{post.summary}</p>
    </header>

    <hr class="my-8" style="border-color: var(--line);" />

    <!-- 文章正文（prose 手写排版，M3 可换 @tailwindcss/typography） -->
    <div class="prose-body text-[15.5px] leading-[1.85]" set:html={content} />

    <footer class="mt-14 border-t pt-6 text-[13px]" style="border-color: var(--line); color: var(--ink-muted);">
      <a href="/" class="transition-colors hover:text-[var(--accent)]">← 返回主站</a>

      {(newer || older) && (
        <nav class="mt-6 grid gap-3 sm:grid-cols-2">
          {newer && (
            <a href={`/posts/${newer.slug}`} class="card group p-4">
              <span class="metalabel">← 新一篇</span>
              <span class="mt-1 block truncate font-semibold transition-colors group-hover:text-[var(--accent)]" style="color: var(--ink);">{newer.title}</span>
            </a>
          )}
          {older && (
            <a href={`/posts/${older.slug}`} class={`card group p-4 text-right ${newer ? '' : 'sm:col-start-2'}`}>
              <span class="metalabel">旧一篇 →</span>
              <span class="mt-1 block truncate font-semibold transition-colors group-hover:text-[var(--accent)]" style="color: var(--ink);">{older.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>
  </article>
</Base>

<style>
  .prose-body :global(h2) {
    margin-top: 2.2em;
    margin-bottom: 0.8em;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .prose-body :global(h3) {
    margin-top: 1.8em;
    margin-bottom: 0.6em;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .prose-body :global(p) { margin: 0.9em 0; }
  .prose-body :global(ul) { margin: 0.9em 0; padding-left: 1.4em; list-style: disc; }
  .prose-body :global(li) { margin: 0.35em 0; }
  .prose-body :global(blockquote) {
    margin: 1.2em 0;
    padding: 0.6em 1.1em;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink);
  }
  .prose-body :global(strong) { font-weight: 700; }
  .prose-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose-body :global(code) {
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 0.88em;
    padding: 0.15em 0.45em;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }
  /* 代码块：底色 + 内边距 + 窄屏横向滚动（深浅主题经 --ink/--line 自动适配） */
  .prose-body :global(pre) {
    margin: 1.2em 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    overflow-x: auto;
    font-size: 0.86em;
    line-height: 1.7;
  }
  .prose-body :global(pre code) {
    padding: 0;
    background: none;
    font-size: inherit;
  }
  /* KaTeX 展示公式在窄屏可横向滚动，不撑破版面 */
  .prose-body :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 0;
  }
  .prose-body :global(hr) { margin: 2em 0; border-color: var(--line); }
</style>
