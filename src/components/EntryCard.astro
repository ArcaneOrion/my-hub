---
import type { Entry } from '../lib/types';
import StatusBadge from './StatusBadge.astro';

interface Props { entry: Entry; index?: number }
const { entry, index = 0 } = Astro.props;

const href =
  entry.kind === 'external'
    ? entry.external_url ?? '#'
    : entry.kind === 'service'
      ? `/s/${entry.id}`
      : `/${entry.id}`;

/* 格子画布制：卡片大小只由网格跨度决定（lg 跨两行），padding 统一，内容自适应填满格子 */
const pad = 'p-6';
/* 仅真正直接外链的卡（kind=external）用 ↗；service 卡去的是站内落地页，仍用 → */
const glyph = entry.kind === 'external' ? '↗' : '→';
---
<a
  href={href}
  class={`card rise group flex h-full flex-col justify-between ${pad}`}
  style={`--i:${index}`}
  {...(entry.kind === 'external' ? { target: '_blank', rel: 'noopener' } : {})}
>
  <div class="flex items-start justify-between">
    <span class="text-[26px] leading-none" aria-hidden="true">{entry.icon}</span>
    {entry.status && <StatusBadge status={entry.status} />}
  </div>
  <div>
    <h2 class={`font-bold tracking-tight ${entry.size_hint === 'lg' ? 'text-xl md:text-2xl' : 'text-[17px]'}`}>
      {entry.title}
      <span class="inline-block transition-transform duration-200 group-hover:translate-x-1 group-hover:text-[var(--accent)]">{glyph}</span>
    </h2>
    {/* tagline 区固定两行高占位：无内容也保留，保证同行卡片标题基线对齐 */}
    <p class="mt-1.5 min-h-[44px] text-[13.5px] leading-relaxed line-clamp-2" style="color: var(--ink-muted);">{entry.tagline}</p>
  </div>
</a>
